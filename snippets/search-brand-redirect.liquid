{%- comment -%}
  Ignite version. Redirects exact-match searches to a collection, using the hidden
  "Search Brands" menu (Online Store > Navigation > search-brands).
  Each menu item's name is a search term; its link is the destination collection.
  Extra spellings (Chevy, Chevrolet, GMC) are separate items pointing to the same collection.
  This menu is separate from the Meteor mega menu, which Liquid can't read.
  Brand hubs get ?view= until the hub template is assigned (pre-launch only).
  Multi-word or unmatched queries fall through to normal search.
{%- endcomment -%}
{%- liquid
  assign rb_menu_handle = 'search-brands'
  assign rb_hub_template = 'vehicle-brand-template'
  assign rb_query = search.terms | downcase | strip
  assign rb_url = ''

  if rb_query != blank
    for rb_link in linklists[rb_menu_handle].links
      if rb_link.type != 'collection_link'
        continue
      endif

      assign rb_title = rb_link.title | downcase | strip
      if rb_title == rb_query
        assign rb_collection = rb_link.object
        assign rb_url = rb_collection.url
        if rb_collection.template_suffix != rb_hub_template
          assign rb_url = rb_url | append: '?view=' | append: rb_hub_template
        endif
        break
      endif
    endfor
  endif
-%}
{%- if rb_url != '' -%}
  <script>window.location.replace({{ rb_url | json }});</script>
{%- endif -%}