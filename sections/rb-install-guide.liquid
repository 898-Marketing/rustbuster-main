{%- comment -%}
  RB Install Guide

  Content for the "Install Guide" tab. Place this section in the tab 2 slot below
  Section tabs. Keep "Show on" set to Both, as Section tabs requires.

  Sources:
  - Heading:            part number from the product title (e.g. RB7423) + "Installation Guide"
  - Intro:              theme editor rich text (same on every product)
  - Install at a glance:
      Welding tile      shows when custom.tools_needed includes a welder
      Sold tile         shows when the product has a "Side" option
      Skill level       custom.skill_level
      Tools needed      custom.tools_needed
  - PDF link:           custom.install_guide (rich text)
  - Video:              custom.install_guide_video (YouTube embed code)

  Each block hides itself when its source is empty.
{%- endcomment -%}

{%- liquid
  assign mf = product.metafields.custom

  assign part_number = ''
  assign last_word = product.title | split: ' ' | last
  assign last_prefix = last_word | slice: 0, 2 | upcase
  if last_prefix == 'RB'
    assign part_number = last_word
  endif
-%}

<div class="color-{{ section.settings.section_color_scheme }} gradient isolate {{ section.settings.line_separator }} {{ section.settings.visibility }}">
  <div class="section__inner page-width {{ section.settings.top_padding }} {{ section.settings.bottom_padding }}">
    <div class="rich-text z-1 content-container content-container--full-width">
      <div class="flex justify-center md:w-full">
        <div class="w-full section-content max-w-{{ section.settings.content_max_width }} text-left p-0">

          {%- if product == blank -%}
            {%- if request.design_mode -%}
              <p class="rb-ig__notice">Open a product in the theme editor to preview this section.</p>
            {%- endif -%}
          {%- else -%}
            <div class="rb-ig">
              {%- for block in section.blocks -%}
                {%- case block.type -%}

                  {%- when 'heading' -%}
                    {%- liquid
                      assign heading_text = block.settings.heading_suffix
                      if part_number != blank
                        assign heading_text = part_number | append: ' ' | append: block.settings.heading_suffix
                      endif
                    -%}
                    {%- if heading_text != blank -%}
                      <{{ block.settings.heading_tag }} class="rb-ig__title {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                        {{- heading_text | escape -}}
                      </{{ block.settings.heading_tag }}>
                    {%- endif -%}

                  {%- when 'text' -%}
                    {%- if block.settings.text != blank -%}
                      <div class="rte {{ block.settings.text_size }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
                    {%- endif -%}

                  {%- when 'glance' -%}
                    {%- liquid
                      assign tools = mf.tools_needed.value
                      assign skill = mf.skill_level.value

                      assign needs_welding = false
                      for tool in tools
                        assign tool_lc = tool | downcase
                        if tool_lc contains 'welder'
                          assign needs_welding = true
                          break
                        endif
                      endfor

                      assign sold_by_side = false
                      assign side_option = block.settings.side_option | downcase | strip
                      for option in product.options
                        assign option_lc = option | downcase | strip
                        if option_lc == side_option
                          assign sold_by_side = true
                          break
                        endif
                      endfor

                      assign has_tiles = false
                      if needs_welding or sold_by_side or skill != blank
                        assign has_tiles = true
                      endif
                    -%}
                    {%- if has_tiles or tools != blank -%}
                      <div class="rb-ig__glance" {{ block.shopify_attributes }}>
                        {%- if block.settings.heading != blank -%}
                          <h3 class="rb-ig__heading {{ section.settings.subheading_size }}">{{ block.settings.heading | escape }}</h3>
                        {%- endif -%}

                        {%- if has_tiles -%}
                          <ul class="rb-ig__tiles" role="list">
                            {%- if needs_welding -%}
                              <li class="rb-ig__tile">
                                <svg class="rb-ig__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20l6-6"/><path d="M14 4l6 6-8 8-6-6z"/></svg>
                                <span class="rb-ig__tile-text">
                                  <span class="rb-ig__label">{{ block.settings.welding_label | escape }}</span>
                                  <span class="rb-ig__value">{{ block.settings.welding_value | escape }}</span>
                                </span>
                              </li>
                            {%- endif -%}
                            {%- if sold_by_side -%}
                              <li class="rb-ig__tile">
                                <svg class="rb-ig__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="7" width="7" height="10" rx="1"/><rect x="14" y="7" width="7" height="10" rx="1"/></svg>
                                <span class="rb-ig__tile-text">
                                  <span class="rb-ig__label">{{ block.settings.sold_label | escape }}</span>
                                  <span class="rb-ig__value">{{ block.settings.sold_value | escape }}</span>
                                </span>
                              </li>
                            {%- endif -%}
                            {%- if skill != blank -%}
                              <li class="rb-ig__tile">
                                <svg class="rb-ig__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20v-6M10 20V10M16 20V6"/></svg>
                                <span class="rb-ig__tile-text">
                                  <span class="rb-ig__label">{{ block.settings.skill_label | escape }}</span>
                                  <span class="rb-ig__value">{{ skill | escape }}</span>
                                </span>
                              </li>
                            {%- endif -%}
                          </ul>
                        {%- endif -%}

                        {%- if tools != blank -%}
                          <div class="rb-ig__tools">
                            <p class="rb-ig__tools-label">
                              <svg class="rb-ig__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z"/></svg>
                              <span class="rb-ig__label">{{ block.settings.tools_label | escape }}</span>
                            </p>
                            <ul class="rb-ig__chips" role="list">
                              {%- for tool in tools -%}
                                <li class="rb-ig__chip">{{ tool | escape }}</li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        {%- endif -%}
                      </div>
                    {%- endif -%}

                  {%- when 'pdf' -%}
                    {%- if mf.install_guide != blank -%}
                      <div class="rte rb-ig__pdf" {{ block.shopify_attributes }}>{{ mf.install_guide | metafield_tag }}</div>
                    {%- endif -%}

                  {%- when 'video' -%}
                    {%- assign embed = mf.install_guide_video.value -%}
                    {%- if embed != blank -%}
                      {%- liquid
                        assign embed_lc = embed | downcase
                        unless embed_lc contains 'loading='
                          assign embed = embed | replace: '<iframe ', '<iframe loading="lazy" '
                        endunless
                      -%}
                      <div class="rb-ig__video rb-ig__video--{{ block.settings.video_width }}" {{ block.shopify_attributes }}>
                        {{- embed -}}
                      </div>
                    {%- endif -%}

                {%- endcase -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .rb-ig {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .rb-ig__title,
  .rb-ig__heading {
    margin: 0;
  }
  .rb-ig__heading {
    margin-bottom: 12px;
  }
  .rb-ig__notice {
    margin: 0 0 16px;
    padding: 10px 14px;
    border: 1px dashed currentColor;
    border-radius: 6px;
    font-size: 14px;
  }

  /* Install at a glance */
  .rb-ig__glance {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .rb-ig__glance .rb-ig__heading {
    margin-bottom: 0;
  }
  .rb-ig__tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }
  @media screen and (min-width: 750px) {
    .rb-ig__tiles {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
    }
  }
  .rb-ig__tile,
  .rb-ig__tools {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
  }
  .rb-ig__tile {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
  }
  @media screen and (min-width: 750px) {
    .rb-ig__tile {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding: 16px 18px;
    }
  }
  .rb-ig__icon {
    flex-shrink: 0;
    color: #b07a00;
  }
  .rb-ig__tile-text {
    display: flex;
    flex-direction: column;
  }
  .rb-ig__label {
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .rb-ig__value {
    font-size: 16px;
    font-weight: 600;
  }
  .rb-ig__tools {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 18px;
  }
  .rb-ig__tools-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
  }
  .rb-ig__chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .rb-ig__chip {
    margin: 0;
    padding: 6px 12px;
    border-radius: 20px;
    background: #f3f4f6;
    font-size: 14px;
    line-height: 1.3;
  }

  /* Video: makes the fixed-size YouTube iframe responsive */
  .rb-ig__video {
    width: 100%;
  }
  .rb-ig__video--medium {
    max-width: 640px;
  }
  .rb-ig__video--large {
    max-width: 860px;
  }
  .rb-ig__video iframe {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 4px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RB Install Guide",
  "tag": "section",
  "class": "section section-rich-text section-rb-install-guide",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Install Guide tab content. Place in the tab 2 slot below Section tabs."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_max_width",
      "options": [
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" },
        { "value": "xl", "label": "XL" }
      ],
      "default": "l",
      "label": "Maximum content width",
      "info": "Match the other tab sections so the tabs stay the same width."
    },
    {
      "type": "select",
      "id": "subheading_size",
      "options": [
        { "value": "h4", "label": "XS" },
        { "value": "h3", "label": "S" },
        { "value": "h2", "label": "M" }
      ],
      "default": "h4",
      "label": "Subheading size"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "line_separator",
      "options": [
        { "value": "", "label": "Off" },
        { "value": "border-top", "label": "Top" },
        { "value": "border-bottom", "label": "Bottom" },
        { "value": "border-top border-bottom", "label": "Both" }
      ],
      "default": "",
      "label": "Line separator"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "select",
      "id": "top_padding",
      "options": [
        { "value": "pt-0", "label": "0" },
        { "value": "pt-s05", "label": "0.5" },
        { "value": "pt-s", "label": "1" },
        { "value": "pt-s15", "label": "1.5" },
        { "value": "pt-s2", "label": "2" }
      ],
      "default": "pt-s",
      "label": "Top section spacing"
    },
    {
      "type": "select",
      "id": "bottom_padding",
      "options": [
        { "value": "pb-0", "label": "0" },
        { "value": "pb-s05", "label": "0.5" },
        { "value": "pb-s", "label": "1" },
        { "value": "pb-s15", "label": "1.5" },
        { "value": "pb-s2", "label": "2" }
      ],
      "default": "pb-s",
      "label": "Bottom section spacing"
    },
    {
      "type": "select",
      "id": "visibility",
      "options": [
        { "value": "visible-xs", "label": "Mobile" },
        { "value": "hidden-xs", "label": "Desktop" },
        { "value": "", "label": "Both" }
      ],
      "default": "",
      "label": "Show on",
      "info": "Must stay 'Both' when this section is a tab."
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the part number from the product title, then the text below (e.g. RB7423 Installation Guide)."
        },
        {
          "type": "text",
          "id": "heading_suffix",
          "default": "Installation Guide",
          "label": "Heading text"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "options": [
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ],
          "default": "h2",
          "label": "Heading tag"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h4", "label": "XS" },
            { "value": "h3", "label": "S" },
            { "value": "h2", "label": "M" },
            { "value": "h1", "label": "L" }
          ],
          "default": "h3",
          "label": "Heading size"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "paragraph",
          "content": "Same text on every product."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "text_size",
          "options": [
            { "value": "t5", "label": "XS" },
            { "value": "t4", "label": "S" },
            { "value": "t3", "label": "M" },
            { "value": "t2", "label": "L" }
          ],
          "default": "t3",
          "label": "Text size"
        }
      ]
    },
    {
      "type": "glance",
      "name": "Install at a glance",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Sources: custom.skill_level and custom.tools_needed. The Welding tile shows when the tools list includes a welder; the Sold tile shows when the product has the side option below."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "header",
          "content": "Welding tile"
        },
        {
          "type": "text",
          "id": "welding_label",
          "default": "Welding",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "welding_value",
          "default": "Required",
          "label": "Value"
        },
        {
          "type": "header",
          "content": "Sold tile"
        },
        {
          "type": "text",
          "id": "side_option",
          "default": "Side",
          "label": "Side option name",
          "info": "The product option that holds Driver / Passenger."
        },
        {
          "type": "text",
          "id": "sold_label",
          "default": "Sold",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "sold_value",
          "default": "By side, L or R",
          "label": "Value"
        },
        {
          "type": "header",
          "content": "Skill level and tools"
        },
        {
          "type": "text",
          "id": "skill_label",
          "default": "Skill level",
          "label": "Skill level label"
        },
        {
          "type": "text",
          "id": "tools_label",
          "default": "Tools needed",
          "label": "Tools label"
        }
      ]
    },
    {
      "type": "pdf",
      "name": "Install guide PDF",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Source: custom.install_guide (rich text with the PDF link)"
        }
      ]
    },
    {
      "type": "video",
      "name": "Install video",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Source: custom.install_guide_video (YouTube embed code)"
        },
        {
          "type": "select",
          "id": "video_width",
          "options": [
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" },
            { "value": "full", "label": "Full width" }
          ],
          "default": "medium",
          "label": "Video width"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RB Install Guide",
      "blocks": [
        { "type": "heading" },
        {
          "type": "text",
          "settings": {
            "text": "<p>Read through the instructions and watch the video before you start, so you can plan the job and check the part against your vehicle before any steel comes out.</p>"
          }
        },
        { "type": "glance" },
        { "type": "pdf" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}